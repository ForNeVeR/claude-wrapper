<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <AssemblyName>claude</AssemblyName>
    <RootNamespace>ClaudeWrapper</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Label="Publishing">
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup Label="Publishing">
    <None Visible="false" Include="..\LICENSE.txt" Link="LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
    <None Visible="false" Include="..\README.md" Link="README.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
    <PackageReference Include="TruePath" />
    <PackageReference Include="TruePath.SystemIo" />
  </ItemGroup>

</Project>
